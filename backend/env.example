# ============================================================================
# activia-trace Backend — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/activia_trace

# --- Secrets ---
SECRET_KEY=your-secret-key-at-least-32-chars-long
ENCRYPTION_KEY=your-32-char-encryption-key-here!

# --- JWT Expiry ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_TOKEN_EXPIRE_MINUTES=5
RECOVERY_TOKEN_EXPIRE_MINUTES=30

# --- Rate Limiting ---
LOGIN_RATE_LIMIT=5/60seconds

# ============================================================================
# C-09: Moodle WS Integration
# ============================================================================

# Base URL of the Moodle instance (e.g. https://moodle.myorg.com)
# Leave empty to disable Moodle WS sync endpoints and nightly task.
MOODLE_BASE_URL=

# Moodle Web Services token (NEVER appears in logs or API responses).
MOODLE_TOKEN=

# Hour (UTC, 0-23) at which the nightly automatic Moodle sync runs (default: 3).
MOODLE_SYNC_HOUR=3

# Maximum rows accepted per roster import file (xlsx/csv). Default: 5000.
PADRON_MAX_ROWS=5000
