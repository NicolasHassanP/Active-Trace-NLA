# ============================================================================
# activia-trace Backend — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/activia_trace

# --- Secrets ---
SECRET_KEY=your-secret-key-at-least-32-chars-long
ENCRYPTION_KEY=your-32-char-encryption-key-here!

# --- JWT Expiry ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_TOKEN_EXPIRE_MINUTES=5
RECOVERY_TOKEN_EXPIRE_MINUTES=30

# --- Rate Limiting ---
LOGIN_RATE_LIMIT=5/60seconds

# ============================================================================
# C-09: Moodle WS Integration
# ============================================================================

# Base URL of the Moodle instance (e.g. https://moodle.myorg.com)
# Leave empty to disable Moodle WS sync endpoints and nightly task.
MOODLE_BASE_URL=

# Moodle Web Services token (NEVER appears in logs or API responses).
MOODLE_TOKEN=

# Hour (UTC, 0-23) at which the nightly automatic Moodle sync runs (default: 3).
MOODLE_SYNC_HOUR=3

# Maximum rows accepted per roster import file (xlsx/csv). Default: 5000.
PADRON_MAX_ROWS=5000

# ============================================================================
# C-10: Calificaciones y umbral de aprobación
# ============================================================================

# Default approval threshold percentage for numeric grades when no UmbralMateria
# is configured by the docente (RN-03). Valid range: 0-100. Default: 60.
UMBRAL_PCT_DEFECTO=60

# Default approving textual values (comma-separated in code; JSON list in env).
# These are the textual grade values that count as "aprobado" when no UmbralMateria
# is configured. Default: ["Satisfactorio", "Supera lo esperado"].
# Note: configured as a Python list in Settings — set via env as JSON array if needed.
# VALORES_APROBATORIOS_DEFECTO=["Satisfactorio", "Supera lo esperado"]

# Default maximum grade for numeric activities when the LMS export does not include
# the maximum in the file header (OQ-2). Default: 10.0.
NOTA_MAXIMA_DEFECTO=10.0
