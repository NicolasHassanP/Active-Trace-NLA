# Base de datos principal
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/activia_trace

# Base de datos de test (usar DB separada, no la de produccion)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/activia_trace_test

# JWT -- minimo 32 caracteres
SECRET_KEY=change-me-to-a-random-32-char-secret-key

# AES-256 -- exactamente 32 caracteres
ENCRYPTION_KEY=change-me-to-32-char-encrypt-key!

# Expiracion del access token en minutos (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# OpenTelemetry -- OTLP endpoint (opcional; si no se define, la app arranca sin exporter)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
